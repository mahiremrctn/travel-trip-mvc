@using TravelTripProje.Models.Sınıflar
@model Blog
<div class="content-form">
    <h3>Bir yorum yapın</h3>
    <form action="/Blog/YorumYap" method="post">
        <input type="hidden" name="BlogID" value="@Model.ID" />
        <input type="text" name="KullaniciAdi" placeholder="Kullanıcı Adı" required />
        <input type="text" placeholder="Mail Adresi" name="Mail" required />
        <textarea placeholder="Yorum" name="Yorum"></textarea>
        <input type="submit" value="Gönder" />
    </form>
</div>